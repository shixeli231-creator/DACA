#include <iostream>
#include <chrono>

using namespace std;
using namespace std::chrono;

// 100x100 Matrix (10,000 floats)
struct Matrix {
    float m[100][100];
};

// The expensive calculation: 100 * 100 * 100 = 1,000,000 operations
Matrix multiplyMatrices(const Matrix& a, const Matrix& b) {
    Matrix result = {};
    for (int i = 0; i < 100; i++) {
        for (int j = 0; j < 100; j++) {
            for (int k = 0; k < 100; k++) {
                result.m[i][j] += a.m[i][k] * b.m[k][j];
            }
        }
    }
    return result;
}

void simulate_delay(long long delay_ns) {
    volatile float x = 1.0f;
    auto start = high_resolution_clock::now();
    while (duration_cast<nanoseconds>(high_resolution_clock::now() - start).count() < delay_ns) {
        x = x * 1.01f;
    }
}

int main() {
    static Matrix matA = {}; 
    static Matrix matB = {};
    
    for(int i=0; i<100; i++) {
        for(int j=0; j<100; j++) {
            matA.m[i][j] = i + j;
            matB.m[i][j] = i * j;
        }
    }

    volatile float dummy;
    int iterations = 1000; 

    static Matrix cachedResult = multiplyMatrices(matA, matB);

    // 1. Naive Compute
    auto start = high_resolution_clock::now();
    for (int i = 0; i < iterations; ++i) {
        Matrix res = multiplyMatrices(matA, matB);
        dummy = res.m[0][0];
    }
    auto stop = high_resolution_clock::now();
    double naive_ms = duration<double, milli>(stop - start).count();
    cout << "Naive Compute:        " << naive_ms << " ms (Baseline)" << endl;

    // 2. DACA L1 Cache (2 ns penalty)
    start = high_resolution_clock::now();
    for (int i = 0; i < iterations; ++i) {
        simulate_delay(2); 
        dummy = cachedResult.m[0][0];
    }
    stop = high_resolution_clock::now();
    double l1_ms = duration<double, milli>(stop - start).count();
    cout << "DACA L1 Cache (2ns):  " << l1_ms << " ms (Speedup: " << naive_ms/l1_ms << "x)" << endl;

    // 3. DACA PCIe (500 ns penalty)
    start = high_resolution_clock::now();
    for (int i = 0; i < iterations; ++i) {
        simulate_delay(500); 
        dummy = cachedResult.m[0][0];
    }
    stop = high_resolution_clock::now();
    double pcie_ms = duration<double, milli>(stop - start).count();
    cout << "DACA PCIe (500ns):    " << pcie_ms << " ms (Speedup: " << naive_ms/pcie_ms << "x)" << endl;

    // 4. DACA Network (100,000 ns penalty)
    start = high_resolution_clock::now();
    for (int i = 0; i < iterations; ++i) {
        simulate_delay(100000); 
        dummy = cachedResult.m[0][0];
    }
    stop = high_resolution_clock::now();
    double net_ms = duration<double, milli>(stop - start).count();
    cout << "DACA Network (100us): " << net_ms << " ms (Speedup: " << naive_ms/net_ms << "x)" << endl;

    return 0;
}

#include <iostream>
#include <vector>
#include <unordered_map>
#include <chrono>
#include <random>
#include <algorithm>
#include <cstdint>

using namespace std;
using namespace chrono;

struct Edge { int to; int delta; };

uint64_t heavy_compute(int a, int b) {
    uint64_t x = static_cast<uint64_t>(a) + 0x9e3779b97f4a7c15ULL;
    for (int i = 0; i < 15000; ++i) {
        x ^= x >> 12; x ^= x << 25; x ^= x >> 27;
        x *= 0x2545F4914F6CDD1DULL;
    }
    return x + static_cast<uint64_t>(b);
}

bool find_path(int start, int target, const vector<Edge> graph[], int &total_delta) {
    vector<bool> visited(32, false);
    vector<int> delta(32, 0);
    vector<int> q;
    q.push_back(start); visited[start] = true;

    for (size_t i = 0; i < q.size(); ++i) {
        int current = q[i];
        if (current == target) { total_delta = delta[current]; return true; }
        for (const Edge &e : graph[current]) {
            if (!visited[e.to]) {
                visited[e.to] = true;
                delta[e.to] = delta[current] + e.delta;
                q.push_back(e.to);
            }
        }
    }
    return false;
}

int main() {
    vector<Edge> graphA[32], graphB[32];
    graphA[3].push_back({9, 6}); graphA[9].push_back({15, 6}); graphA[15].push_back({21, 6});
    graphB[3].push_back({9, 6}); graphB[3].push_back({15, 12}); graphB[3].push_back({21, 18});

    vector<pair<int,int>> reqs;
    for (int a = 0; a < 1000; ++a) {
        reqs.push_back({a, 3}); reqs.push_back({a, 9});
        reqs.push_back({a, 15}); reqs.push_back({a, 21});
    }
    mt19937 rng(42); shuffle(reqs.begin(), reqs.end(), rng);

    unordered_map<uint64_t, uint64_t> memory;
    uint64_t rel_hits = 0, conflicts = 0;

    for (auto [a,b] : reqs) {
        uint64_t k = (static_cast<uint64_t>(a) << 32) | b;
        if (memory.count(k)) continue;

        bool valid = (a % 4 != 0);
        bool corrupted = (a % 10 == 1);
        auto anchor = memory.find((static_cast<uint64_t>(a) << 32) | 3);
        
        bool usable = false;

        if (b != 3 && valid && anchor != memory.end()) {
            int dA = 0, dB = 0;
            if (find_path(3, b, graphA, dA) && find_path(3, b, graphB, dB)) {
                uint64_t resA = anchor->second + dA;
                uint64_t resB = anchor->second + (corrupted ? dB + 5 : dB);
                
                if (resA == resB) { memory[k] = resA; rel_hits++; usable = true; }
                else { conflicts++; }
            }
        }
        if (!usable) memory[k] = heavy_compute(a,b);
    }

    cout << "Rel Hits: " << rel_hits << " | Conflicts Caught: " << conflicts << "\n";
    return 0;
}
